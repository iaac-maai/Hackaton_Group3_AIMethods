# Copy to .dev.vars for local development (not committed).
# Local model server: python -m uvicorn app:app --app-dir 02_model_server --port 8000
RENDER_API_URL=http://127.0.0.1:8000
# Shared team password for the local login page. Choose your own value and put it in .dev.vars only.
# Use a different value than production (set there with `npx wrangler secret put APP_PASSWORD`).
# Never commit a real value. Without it, the app shows "Login is not configured."
APP_PASSWORD=
